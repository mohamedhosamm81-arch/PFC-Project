# =============================================================================
# PFC — Patient Flow Controller
# Copy this file to `.env` and replace every CHANGE_ME value before starting.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------- application
APP_NAME=PFC Backend
APP_VERSION=1.0.0
# production | staging | development | test
APP_ENV=production
DEBUG=false
# Swagger/OpenAPI is intentionally disabled in production.
DOCS_ENABLED=false
API_PREFIX=/api
LOG_LEVEL=INFO

# ------------------------------------------------------------------- security
# Generate a unique value (32+ characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_unique_48_character_secret
JWT_ALGORITHM=HS256
JWT_ISSUER=pfc-backend
JWT_AUDIENCE=pfc-clients
# 480 minutes = 8-hour shift.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------- database
# These values are consumed by the MySQL container and compose interpolation.
MYSQL_DATABASE=pfc
MYSQL_USER=pfc_user
MYSQL_PASSWORD=CHANGE_ME_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

# The backend container connects to the `mysql_db` service.
# Special characters in the password must be URL-encoded (for example @ -> %40).
DATABASE_URL=mysql+asyncmy://pfc_user:CHANGE_ME_database_password@mysql_db:3306/pfc
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=3600

# ------------------------------------------------------------- http / realtime
BACKEND_PORT=8000
# Comma-separated browser origins allowed to call the API. Include every LAN
# hostname or IP address used by kiosks/consoles, e.g.
# http://192.168.1.50:8000,http://pfc.local:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
# Leave empty to reuse CORS_ORIGINS for WebSocket Origin checks.
WS_ORIGINS=
WS_RECEIVE_TIMEOUT_SECONDS=90
MAX_WS_SUBSCRIPTIONS=20

# -------------------------------------------------------------- business rules
# IANA timezone used for shifts, reports and daily slot limits.
FACILITY_TIMEZONE=Africa/Cairo
# Lateness only counts beyond this grace period (minutes).
ATTENDANCE_GRACE_MINUTES=15
# Daily CMO issuance count that triggers the overbooking flag.
DOCTOR_DAILY_SLOT_LIMIT=20

# --------------------------------------------------------------------- seeding
# Applied automatically by the container entrypoint unless SEED_ON_START=false.
SEED_ON_START=true
SEED_DEMO_DATA=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
SEED_ADMIN_FULL_NAME=System Administrator
SEED_DEMO_PASSWORD=CHANGE_ME_demo_password
